PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Optional: override default admin (id 1) — set in production
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Set to 1 if the app is behind a reverse proxy (for correct client IP in rate limiting and logs)
# TRUST_PROXY=1

# Optional: ImgBB API key for storing item images externally (get one at https://api.imgbb.com/)
# When set, new item uploads go to ImgBB and items get an imageUrl; avoids large repo and works on Render.
# IMGBB_API_KEY=your_imgbb_api_key

# Supabase — Project Settings → API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# New keys (preferred): publishable + secret
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy keys (still work): anon + service_role
SUPABASE_ANON_KEY=
# service_role / secret — server only. Never commit this or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
